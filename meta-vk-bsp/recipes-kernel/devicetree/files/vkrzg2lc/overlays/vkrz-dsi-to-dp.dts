/dts-v1/;
/plugin/;

#include <dt-bindings/pinctrl/rzg2l-pinctrl.h>
#include <dt-bindings/gpio/gpio.h>

/ {
	compatible = "vekatech,vkrzg2lc", "renesas,r9a07g044";

	fragment@6 {
		target-path = "/";
		__overlay__ {

			edp_1v2: 1p2v {
				compatible = "regulator-fixed";
				regulator-name = "edp_1v2";
				regulator-min-microvolt = <1200000>;
				regulator-max-microvolt = <1200000>;
				regulator-always-on;
			};
			edp_1v8: 1p8v {
				compatible = "regulator-fixed";
				regulator-name = "edp_1v8";
				regulator-min-microvolt = <1800000>;
				regulator-max-microvolt = <1800000>;
				regulator-always-on;
			};

			// mini-dp-con {
			// 	status = "okay";
			// 	compatible = "dp-connector";
			// 	label = "CN3";
			// 	type = "mini";

			// 	port {
			// 		mini_dp_con_in: endpoint {
			// 			remote-endpoint = <&bridge_out>;
			// 		};
			// 	};
			// };
		};
	};
};

&i2c1 {
	#address-cells = <1>;
	#size-cells = <0>;

	bridge@2c {
		status = "okay";
		compatible = "ti,sn65dsi86";
		reg = <0x2c>;

		enable-gpios = <&pinctrl RZG2L_GPIO(4, 1) GPIO_ACTIVE_HIGH>;

		vccio-supply = <&edp_1v8>;
		vpll-supply = <&edp_1v8>;
		vcca-supply = <&edp_1v2>;
		vcc-supply = <&edp_1v2>;

		ports {
			#address-cells = <1>;
			#size-cells = <0>;

			port@0 {
				reg = <0>;
				bridge_in: endpoint {
					remote-endpoint = <&dsi0_out>;
					data-lanes = <1 2 3 4>;
				};
			};

			port@1 {
				reg = <1>;
				bridge_out: endpoint {
					data-lanes = <0 1 2 3>;
					remote-endpoint = <&mini_dp_con_in>;
				};
			};
		};

        aux-bus {
			mini-dp-con {
				status = "okay";
				compatible = "dp-connector";
				label = "CN3";
				type = "mini";
				port {
					mini_dp_con_in: endpoint {
						remote-endpoint = <&bridge_out>;
					};
				};
			};
        };
	};
};

&du {
	status = "okay";
};

&dsi {
	status = "okay";
	ports {
		#address-cells = <1>;
		#size-cells = <0>;
		port@1 {
			reg = <1>;
			dsi0_out: endpoint {
				data-lanes = <1 2 3 4>;
				remote-endpoint = <&bridge_in>;
			};
		};
	};
};

&gpt3 {
	status = "okay";
};

&backlight {
	status = "okay";
};
